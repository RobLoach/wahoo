# Route everything through the Slim front controller.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Never serve the database, composer internals, or tooling directly.
RewriteRule ^(data|vendor|bin|tests)/ - [F,L]

# Snapshots are repetitive JSON that compresses ~10x: gzip them on the way out.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/json
</IfModule>
