# Route everything through the Slim front controller.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Never serve the database or composer internals directly.
RewriteRule ^(data|vendor)/ - [F,L]

# Snapshots are repetitive JSON that compresses ~10x: gzip them on the way out.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/json
</IfModule>
